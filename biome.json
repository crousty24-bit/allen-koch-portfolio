{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!docs/maquettes_references/minimalist-developer-portfolio-templates/variante-a.html",
      "!docs/maquettes_references/minimalist-developer-portfolio-templates/variante-b.html",
      "!docs/maquettes_references/minimalist-developer-portfolio-templates/variante-c.html",
      "!docs/maquettes_references/minimalist-developer-portfolio-templates/variante-d.html"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
